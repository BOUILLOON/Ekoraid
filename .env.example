# Exemple de paramètres. Lancez d'abord « python -m playlist25 init ».
# Ajoutez ensuite les paramètres voulus à .env.local ; conservez ses secrets générés.
# ADMIN_PASSWORD=<créé aléatoirement par init ; modifiable avec configure-admin>
# SESSION_SECRET=<créé aléatoirement par init ; ne pas publier>
EVENT_NAME="Les 25 ans de Fanny"
DATA_DIR=data
GUEST_HOST=0.0.0.0
GUEST_PORT=8000
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8001
LOCAL_URL=http://127.0.0.1:8000
PUBLIC_URL=
COOKIE_SECURE=false
MAX_PROPOSALS=0
MAX_PLAYLIST_ITEMS=0
MAX_DURATION=1800
MAX_UPLOAD_MB=100
MAX_QUEUE_SIZE=0
MIN_FREE_MB=256
TASK_TIMEOUT=600
MAX_ATTEMPTS=2
SEARCH_LIMIT=5
OUTPUT_FORMAT=mp3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
JS_RUNTIME=node
# YT_DLP_PATH omis : utilise le Python de l'environnement et son module yt_dlp.
# Collecte GitHub Pages + Supabase facultative, voir cloud/README.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# La clé service_role est privée : uniquement .env.local, jamais le site public.
SUPABASE_SERVICE_ROLE_KEY=
